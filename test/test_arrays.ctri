// Test file for full C11 array support

// 1. Basic arrays
int arr1[5];
int arr2[3] = {1, 2, 3};

// 2. Inferred size
int arr3[] = {1, 2, 3, 4, 5};

// 3. 2D arrays
int matrix[2][3] = {{1, 2, 3}, {4, 5, 6}};

// 4. Partial init (zero-fill remainder)
int arr4[5] = {1, 2};

// 5. Designated initializers
int arr5[5] = {[2] = 10};

// 6. String to char array
char str[] = "hello";

// 7. Flexible array member in struct
struct Data {
    int count;
    int items[];
};

int main(void) {
    arr1[0] = 1;
    arr1[4] = 5;

    int x = arr2[0];
    int y = arr3[4];
    int z = matrix[1][2];
    int w = arr4[3];
    int v = arr5[2];

    return 0;
}