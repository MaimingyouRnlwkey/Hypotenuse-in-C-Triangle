#include <unistd.h>
#include <string.h>
#include <stdarg.h>

void print_c(char c) { write(1, &c, 1); }

void print_s(const char* s) { if (s) write(1, s, strlen(s)); }

void print_num(unsigned long n, int base, int upper) {
    if (n == 0) { print_c('0'); return; }
    char buf[32];
    int i = 0;
    while (n) {
        int d = n % base;
        buf[i++] = d < 10 ? '0' + d : (upper ? 'A' + d - 10 : 'a' + d - 10);
        n /= base;
    }
    while (i) print_c(buf[--i]);
}

void print_d(int n) {
    if (n < 0) { print_c('-'); n = -n; }
    print_num(n, 10, 0);
}

void print_ld(long n) {
    if (n < 0) { print_c('-'); n = -n; }
    print_num(n, 10, 0);
}

void print_lld(long long n) {
    if (n < 0) { print_c('-'); n = -n; }
    print_num(n, 10, 0);
}

void print_f(double f) {
    if (f < 0) { print_c('-'); f = -f; }
    long ip = (long)f;
    print_num(ip, 10, 0);
    print_c('.');
    for (int i = 0; i < 6; i++) {
        f *= 10;
        print_c('0' + (int)f);
        f -= (int)f;
    }
}

void printd(const char* fmt, ...) {
    va_list a;
    va_start(a, fmt);
    while (*fmt) {
        if (*fmt == '%') {
            fmt++;
            char c = *fmt;
            if (c == 'l') {
                char c2 = *(fmt + 1);
                if (c2 == 'l' && *(fmt + 2) == 'd') { print_lld(va_arg(a, long long)); fmt += 2; }
                else if (c2 == 'd') { print_ld(va_arg(a, long)); fmt++; }
                else if (c2 == 'u') { print_num(va_arg(a, unsigned long), 10, 0); fmt++; }
            } else if (c == 'd' || c == 'i') { print_d(va_arg(a, int)); }
            else if (c == 'u') { print_num(va_arg(a, unsigned int), 10, 0); }
            else if (c == 'o') { print_num(va_arg(a, unsigned int), 8, 0); }
            else if (c == 'x') { print_num(va_arg(a, unsigned int), 16, 0); }
            else if (c == 'X') { print_num(va_arg(a, unsigned int), 16, 1); }
            else if (c == 'p') { print_num((unsigned long)va_arg(a, void*), 16, 0); }
            else if (c == 's') { print_s(va_arg(a, char*)); }
            else if (c == 'c') { print_c((char)va_arg(a, int)); }
            else if (c == 'f') { print_f(va_arg(a, double)); }
            else if (c == '%') { print_c('%'); }
            else { print_c('%'); print_c(c); }
        } else { print_c(*fmt); }
        fmt++;
    }
    va_end(a);
}